# Backend API URL for mobile development
# Use your computer's local IP address - find it with: ipconfig | findstr IPv4
# Replace 192.168.x.x with your actual local IP address
REACT_APP_API_URL=http://192.168.1.100:8080/api

# Note: You need to replace 192.168.1.100 with your actual computer's IP address
# To find it, run: ipconfig | findstr IPv4
# Use the IPv4 address from your WiFi/Ethernet adapter (usually starts with 192.168.x.x)