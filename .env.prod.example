# ========================
# Application Configuration
# ========================
DOMAIN=rispo.co.zw

# Docker Image (will be set by GitHub Actions)
DOCKER_IMAGE=ghcr.io/charindal/rispo
IMAGE_TAG=latest

# ========================
# Database Configuration
# ========================
DB_NAME=rispo
DB_USER=rispo_admin
DB_PASSWORD=change_this_secure_password_123

# ========================
# Redis Configuration
# ========================
REDIS_PASSWORD=change_this_redis_password_456

# ========================
# RabbitMQ Configuration
# ========================
RABBITMQ_USER=rispo_admin
RABBITMQ_PASSWORD=change_this_rabbitmq_password_789

# ========================
# JWT Secret (must be long and secure)
# ========================
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_characters_long

# ========================
# Let's Encrypt / ACME
# ========================
ACME_EMAIL=admin@your-domain.com

# ========================
# Traefik Dashboard Authentication
# Generate with: echo $(htpasswd -nb admin your_password) | sed 's/\$/\$\$/g'
# Or use: docker run --rm httpd:2.4-alpine htpasswd -nbB admin your_password | sed 's/\$/\$\$/g'
# ========================
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz123$$abcdef

# ========================
# Grafana Configuration
# ========================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_grafana_password

# ========================
# Metrics Authentication (for Prometheus)
# Generate same as TRAEFIK_DASHBOARD_AUTH
# ========================
METRICS_AUTH=admin:$$apr1$$xyz123$$abcdef
